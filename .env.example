# Copy to .env.local (or set in Vercel → Settings → Environment Variables).
# Read at build time: on Vercel, redeploy after changing any of these.

# Enables smart answers. Without it, only random answers are used.
AI_GATEWAY_API_KEY=

# Notice shown at the top when the site opens. Leave empty for none.
# Inline Markdown: **bold**, *italic*, `code`, [link](https://…).
# Two spaces start a new paragraph.
SITE_NOTICE="**Heads up!**  This is a **demo**. See the [GitHub repo](https://github.com/raulmouzo/magic-8) for more."

# How long the notice stays, in milliseconds (default 5000).
SITE_NOTICE_DURATION=8000

# true: show on every page load. Otherwise, once per browser session.
SITE_NOTICE_ALWAYS=false
